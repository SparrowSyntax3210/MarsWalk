# Node dependencies and local secrets
node_modules/
.env
.env.*
!.env.example

# Python environments and generated bytecode
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]

# Mars source data stays on the developer machine. The small NASA traverse
# validation GeoJSON is retained in Git for the route comparison script.
/python/mars_datasets/data/raw/*
!/python/mars_datasets/data/raw/route_validation/
/python/mars_datasets/data/raw/route_validation/*
!/python/mars_datasets/data/raw/route_validation/nasa_curiosity_traverse.geojson

# Large derived stores and source-layer intermediates stay local.
/python/mars_datasets/data/processed/feature_store/**
/python/mars_datasets/data/processed/rasters/**
/python/mars_datasets/data/processed/vectors/**
/python/mars_datasets/data/processed/climate/**

# Jezero scene rasters and generated model outputs stay local. Keep compact
# patches, manifests, metrics, reports, and the two small baseline checkpoints.
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/*.tif
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/**/*.tif
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/*.parquet
!/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/jezero_context_1km.parquet
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/model/*.pt
!/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/model/jezero_multimodal_unet.pt
!/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/model/jezero_small_unet.pt
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/model/*.pth
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/model/*.bin
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/prediction_overlays/
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/prediction_overlays_multimodal/
/python/mars_datasets/data/processed/vision_prototype/jezero_ctx/qa_overlays/

# Logs and editor/OS artifacts
*.log
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
